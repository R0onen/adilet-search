# Adilet Search environment. Copy to `.env` (git-ignored) and adjust.
# This file feeds docker compose. When you run the backend on the host instead
# (`cd backend && uv run ...`), the built-in defaults already point to localhost; override single
# values with environment variables or a git-ignored `backend/.env`.
# Dev defaults are safe for a laptop. In production (ENVIRONMENT=prod) every secret must be set
# to a strong random value; the backend refuses to start with dev secrets.
# Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- app ---------------------------------------------------------------------------------
# dev | test | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO
# true: one JSON object per line; false: human-readable console output
LOG_JSON=true
# Comma-separated list of browser origins allowed by CORS (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
# Git commit shown by /api/v1/version (set by CI/deploy scripts)
GIT_SHA=dev

# --- PostgreSQL ----------------------------------------------------------------------------
POSTGRES_USER=adilet
POSTGRES_PASSWORD=adilet
POSTGRES_DB=adilet
# Host port for local tools (psql, tests). Bound to 127.0.0.1 only.
POSTGRES_PORT=5432
# Backend DB URL. Compose builds it from the POSTGRES_* values above; the host default is:
# DATABASE_URL=postgresql+asyncpg://adilet:adilet@localhost:5432/adilet
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- Qdrant --------------------------------------------------------------------------------
QDRANT_PORT=6333
# Compose sets http://qdrant:6333; the host default is:
# QDRANT_URL=http://localhost:6333
# Optional; empty in dev
QDRANT_API_KEY=
# Collections are legal_chunks__{pipeline_version}; search goes through this alias
QDRANT_ALIAS=legal_chunks
QDRANT_TIMEOUT_S=5
# The backend talks gRPC to Qdrant (1.5 ms vs ~44 ms per query over REST, measured in BE-02).
QDRANT_PREFER_GRPC=true
# Host port for gRPC (compose uses 6334 internally). Bound to 127.0.0.1 only.
QDRANT_GRPC_PORT=6334

# --- ML service (contracts/ml_service.md) --------------------------------------------------
# Inside compose: http://fake-ml:8001 (profile dev) or http://ml-service:8001 (profile ml).
# The host default is http://localhost:8001.
ML_SERVICE_URL=http://fake-ml:8001
ML_CONNECT_TIMEOUT_S=2
ML_TIMEOUT_S=10
# Where the model manifest comes from: service (GET /version) | file (MODEL_MANIFEST_PATH)
MANIFEST_SOURCE=service
# Path of the manifest when MANIFEST_SOURCE=file (host default: ../ml/models/model_manifest.json)
# MODEL_MANIFEST_PATH=/models/model_manifest.json
# Seconds between retries while the manifest cannot be loaded
MANIFEST_RETRY_S=30
# Per-component timeout of /api/v1/health probes
HEALTH_TIMEOUT_S=2

# --- search time budgets (seconds; /search p95 target is 2 s) ------------------------------
# A failed/slow embed or retrieval answers 503 (full-text fallback from BE-04 on).
SEARCH_EMBED_TIMEOUT_S=2
SEARCH_RETRIEVE_TIMEOUT_S=2
# A failed/slow reranker returns the fused order with degraded: ["rerank"].
SEARCH_RERANK_TIMEOUT_S=1.5
# How long a usable active collection + its index_compat_id are cached ("no index" never is)
INDEX_STATE_TTL_S=30

# --- answer (SSE) ------------------------------------------------------------------------------
# Total time allowed for generation (also the max wait for each streamed chunk, so it must
# cover time-to-first-token on a CPU LLM). On timeout the stream ends with an `error` event.
ANSWER_TIMEOUT_S=90
# Passed to ml-service /generate (contract max 1024)
ANSWER_MAX_TOKENS=512
ANSWER_TEMPERATURE=0.1
# Heartbeat comment `: ping` interval
SSE_PING_S=15

# --- fake ML service (profile dev only) ----------------------------------------------------
FAKE_ML_PORT=8001
FAKE_ML_DIM=768
# Comma list of embed | rerank | generate | all: those endpoints fail (resilience drills)
FAKE_ML_FAIL=
# Extra latency on embed/rerank and before the first generated token
FAKE_ML_LATENCY_MS=0
FAKE_ML_TOKEN_DELAY_MS=20

# --- real ml-service (profile ml; image built from ml/, owned by ML) ----------------------
# Host port of ml-service (the fake-ml of profile dev uses 8001 too: run one or the other)
ML_SERVICE_PORT=8001
# hash (bootstrap, no download) | sentence-transformers (real E5, downloads the model)
ADILET_ML_EMBEDDER_BACKEND=hash
# fallback (extractive, no LLM) | openai (calls LLM_BASE_URL)
ADILET_ML_GENERATOR_MODE=fallback

# --- LLM (used by ml-service; owned by ML) -------------------------------------------------
# Base URL WITHOUT /v1: ml-service appends /v1/chat/completions itself
LLM_BASE_URL=http://llm:8002
LLM_MODEL=adilet-generator
LLM_API_KEY=

# --- backend ports ---------------------------------------------------------------------------
BACKEND_PORT=8000

# --- privacy / secrets -----------------------------------------------------------------------
# Salt for hashing X-Session-Id before it is stored. REQUIRED (strong, random) in prod.
SESSION_SALT=dev-only-session-salt
