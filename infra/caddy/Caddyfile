# Public reverse proxy of the production stack (docker-compose.prod.yml).
#
# SITE_ADDRESS decides the mode:
#   example.kz   -> automatic HTTPS (Let's Encrypt); ports 80 and 443 must be reachable
#   :80          -> plain HTTP, for a local check or behind another TLS terminator
{
	admin off
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# The UI loads only its own scripts and styles, and calls only its own origin.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# The API. /metrics is not under /api, so it is never exposed.
	handle /api/* {
		reverse_proxy backend:8000 {
			# Streamed answers (SSE) must reach the browser token by token.
			flush_interval -1
		}
	}

	# Grafana has its own login and is served from this sub-path.
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	handle {
		reverse_proxy frontend:8080
	}
}
